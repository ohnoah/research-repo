  "components": {
    "schemas": {
      "RequiredFieldsSchema": {
        "description": "All fields are required with no defaults.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "age": {
            "title": "Age",
            "type": "integer"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "age",
          "email",
          "is_active"
        ],
        "title": "RequiredFieldsSchema",
        "type": "object"
      },
      "OptionalFieldsSchema": {
        "description": "Fields that can be None but are still required in input.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          },
          "middle_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Middle Name"
          }
        },
        "required": [
          "name",
          "nickname",
          "middle_name"
        ],
        "title": "OptionalFieldsSchema",
        "type": "object"
      },
      "DefaultValueFieldsSchema": {
        "description": "Fields with default values - should be optional in requests.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "count": {
            "default": 0,
            "title": "Count",
            "type": "integer"
          },
          "is_enabled": {
            "default": true,
            "title": "Is Enabled",
            "type": "boolean"
          },
          "description": {
            "default": "No description",
            "title": "Description",
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "title": "DefaultValueFieldsSchema",
        "type": "object"
      },
      "OptionalWithNoneDefaultSchema": {
        "description": "Optional fields with None as default - most permissive.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          },
          "bio": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Bio"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          }
        },
        "required": [
          "name"
        ],
        "title": "OptionalWithNoneDefaultSchema",
        "type": "object"
      },
      "OptionalWithValueDefaultSchema": {
        "description": "Optional fields but with non-None defaults.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "Anonymous",
            "title": "Nickname"
          },
          "status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "pending",
            "title": "Status"
          }
        },
        "required": [
          "name"
        ],
        "title": "OptionalWithValueDefaultSchema",
        "type": "object"
      },
      "MixedPatternsSchema": {
        "description": "A realistic mix of patterns.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "external_ref": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "External Ref"
          },
          "page": {
            "default": 1,
            "title": "Page",
            "type": "integer"
          },
          "limit": {
            "default": 10,
            "title": "Limit",
            "type": "integer"
          },
          "sort_order": {
            "default": "asc",
            "title": "Sort Order",
            "type": "string"
          },
          "filter_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Filter Name"
          },
          "search_query": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Query"
          },
          "default_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "active",
            "title": "Default Status"
          }
        },
        "required": [
          "id",
          "name",
          "parent_id",
          "external_ref"
        ],
        "title": "MixedPatternsSchema",
        "type": "object"
      },
      "FieldDescriptorSchema": {
        "description": "Testing Field() descriptor patterns.",
        "properties": {
          "name": {
            "maxLength": 100,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "email": {
            "description": "User's email address",
            "title": "Email",
            "type": "string"
          },
          "age": {
            "anyOf": [
              {
                "maximum": 150,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age"
          },
          "country": {
            "default": "US",
            "description": "ISO country code",
            "title": "Country",
            "type": "string"
          },
          "role": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "user",
            "description": "User role",
            "title": "Role"
          }
        },
        "required": [
          "name",
