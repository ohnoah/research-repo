# Database configuration
DB_NAME=myapp_db
DB_USER=myapp_user
DB_PASSWORD=myapp_password

# Direct PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432

# PgBouncer connection (for pooled access)
DB_HOST_POOLED=localhost
DB_PORT_POOLED=6432

# Django settings
DJANGO_SETTINGS_MODULE=myapp.settings
DEBUG=true
SECRET_KEY=your-secret-key-here
