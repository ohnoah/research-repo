{
  "openapi": "3.1.0",
  "info": {
    "title": "Fixed Types Demo API",
    "version": "2.0.0",
    "description": "Demonstrating how to get clean TypeScript types from Django Ninja"
  },
  "paths": {
    "/api-fixed/items": {
      "post": {
        "operationId": "api_api_fixed_create_item",
        "summary": "Create Item",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse"
                }
              }
            }
          }
        },
        "description": "CORRECT pattern: Different schemas for request and response.\n- CreateItemRequest: fields with defaults are optional (can omit)\n- ItemResponse: all fields are required (always present)",
        "tags": [
          "fixed"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateItemRequest"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api-fixed/all-required": {
      "get": {
        "operationId": "api_api_fixed_get_all_required",
        "summary": "Get All Required",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AllRequiredResponse"
                }
              }
            }
          }
        },
        "description": "Response with all fields forced to required.",
        "tags": [
          "fixed"
        ]
      }
    },
    "/api-fixed/clean-nullable": {
      "post": {
        "operationId": "api_api_fixed_create_clean_nullable",
        "summary": "Create Clean Nullable",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CleanNullableSchema"
                }
              }
            }
          }
        },
        "description": "Clean nullable field handling.",
        "tags": [
          "fixed"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CleanNullableSchema"
              }
            }
          },
          "required": true
        }
      }
    },
    "/api-fixed/profile/{user_id}": {
      "get": {
        "operationId": "api_api_fixed_get_profile",
        "summary": "Get Profile",
        "parameters": [
          {
            "in": "path",
            "name": "user_id",
            "schema": {
              "title": "User Id",
              "type": "integer"
            },
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponse"
                }
              }
            }
          }
        },
        "description": "Using ResponseBase for automatic required fields.",
        "tags": [
          "fixed"
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "ItemResponse": {
        "description": "RESPONSE schema - NO defaults, all fields are always present.\nTypeScript: all fields should be required (no `?`).",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "count": {
            "title": "Count",
            "type": "integer"
          },
          "is_active": {
            "title": "Is Active",
            "type": "boolean"
          },
          "priority": {
            "$ref": "#/components/schemas/Priority"
          },
          "metadata": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "required": [
          "id",
          "name",
          "count",
          "is_active",
          "priority",
          "metadata"
        ],
        "title": "ItemResponse",
        "type": "object"
      },
      "Priority": {
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "title": "Priority",
        "type": "string"
      },
      "CreateItemRequest": {
        "description": "REQUEST schema - defaults are appropriate here.\nFields with defaults CAN be omitted by the client.\nTypeScript: `field?: type` is CORRECT here.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "count": {
            "default": 0,
            "title": "Count",
            "type": "integer"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Priority"
              }
            ],
            "default": "medium"
          },
          "metadata": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "required": [
          "name"
        ],
        "title": "CreateItemRequest",
        "type": "object"
      },
      "AllRequiredResponse": {
        "description": "Force all fields to be required using model_config.\nThis fixes the 'default makes it optional' problem.",
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "count": {
            "default": 0,
            "title": "Count",
            "type": "integer"
          },
          "is_active": {
            "default": true,
            "title": "Is Active",
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "count",
          "is_active"
        ],
        "title": "AllRequiredResponse",
        "type": "object"
      },
      "CleanNullableSchema": {
        "description": "Use ONLY `| None` for nullable fields, NOT Optional.\nAnd be explicit about whether the field is required.",
        "properties": {
          "required_nullable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Nullable"
          },
          "required_non_null": {
            "title": "Required Non Null",
            "type": "string"
          },
          "optional_nullable": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Optional Nullable"
          }
        },
        "required": [
          "required_nullable",
          "required_non_null",
          "optional_nullable"
        ],
        "title": "CleanNullableSchema",
        "type": "object"
      },
      "UserProfileResponse": {
        "description": "All fields will be required in OpenAPI schema.",
        "properties": {
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "username": {
            "title": "Username",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "avatar_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Avatar Url"
          },
          "created_at": {
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "avatar_url",
          "created_at"
        ],
        "title": "UserProfileResponse",
        "type": "object"
      }
    }
  },
  "servers": []
}